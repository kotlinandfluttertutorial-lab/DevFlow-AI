APP_NAME="DevFlow AI" # Application display name
APP_VERSION=0.1.0 # Application version
ENVIRONMENT=development # development, local, test, staging, or production
API_HOST=127.0.0.1 # Local API bind address
API_PORT=8000 # API port
UI_HOST=127.0.0.1 # Local UI bind address
UI_PORT=8501 # UI port
ALLOWED_ORIGINS='["http://localhost:8501"]' # JSON array of allowed browser origins
DEVFLOW_API_BASE_URL=http://localhost:8000 # API base URL used by the UI
DATABASE_URL=sqlite+aiosqlite:///./devflow.db # Local SQLite database path
LOG_LEVEL=INFO # Minimum log level
LOG_FORMAT=text # text or json
CHATGPT_API_KEY=your_chatgpt_api_key_here # Optional ChatGPT placeholder
CODEX_API_KEY=your_codex_api_key_here # Reserved for a future optional Codex API adapter
ANTHROPIC_API_KEY=your_anthropic_api_key_here # Optional Claude placeholder
GITHUB_TOKEN=your_github_token_here # Optional GitHub placeholder
FIGMA_TOKEN=your_figma_token_here # Optional Figma placeholder
OLLAMA_BASE_URL=http://localhost:11434 # Local Ollama endpoint
OLLAMA_TIMEOUT_SECONDS=30 # Maximum seconds per Ollama request
GITHUB_API_BASE_URL=https://api.github.com # GitHub API origin
LOCAL_OPERATOR_ID=local_operator # Server-side local GitHub operator identity
APPROVAL_TTL_SECONDS=3600 # Pending workflow approval lifetime
APPROVAL_AUTHORIZATION_VALIDITY_SECONDS=3600 # Approved workflow authorization lifetime
RUN_CONCURRENCY=1
STEP_LEASE_TTL_SECONDS=60
STEP_HEARTBEAT_INTERVAL_SECONDS=15
APPROVED_WORKING_DIRECTORIES=[]
EXECUTOR_ENV_ALLOWLIST=[]
GITHUB_CONFIRMATION_TTL_SECONDS=600 # Single-use GitHub confirmation lifetime
FIGMA_API_BASE_URL=https://api.figma.com # Figma API origin
MCP_SERVERS_CONFIG="" # Optional JSON list of local MCP server commands and allow-lists
